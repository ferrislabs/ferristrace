# Copy to .env beside this file. Every line here is commented out, so a copy
# changes nothing: the stack comes up on a clean machine with no preparation.
#
# The file does two jobs. The names without a FERRISTRACE_ prefix are read by
# the compose file itself, to fill in a password or a port. The ones with it
# are handed to the server, which reads any FERRISTRACE_<BLOCK>__<FIELD> as
# the field of a block in ferristrace.toml.

# ---------------------------------------------------------------- the stack

# The three stores default to `ferristrace`, which is fine for a laptop and
# nothing else. Change both before this faces anything real — and before
# widening POSTGRES_BIND, which is what would put that database on a network.
#POSTGRES_PASSWORD=
#CLICKHOUSE_PASSWORD=
#POSTGRES_BIND=127.0.0.1
#POSTGRES_PORT=5432

#OTLP_GRPC_PORT=4317
#OTLP_HTTP_PORT=4318
#RETENTION_DAYS=30
#RUST_LOG=info

# false because this compose file serves plain HTTP. Put the server behind
# TLS and set it to true, or session cookies travel in the clear.
#COOKIE_SECURE=false

# A published image to run instead of building from this checkout.
#FERRISTRACE_IMAGE=ghcr.io/ferristrace/ferristrace:1.2.3

# ------------------------------------------------- signing in with an idp

# Set the four and local passwords become unnecessary.
#FERRISTRACE_OIDC__ISSUER=https://id.example.com
#FERRISTRACE_OIDC__CLIENT_ID=ferristrace
#FERRISTRACE_OIDC__CLIENT_SECRET=
#FERRISTRACE_OIDC__REDIRECT_URI=https://ferristrace.example.com/auth/oidc/callback
#FERRISTRACE_LOCAL_PASSWORD=false

# --------------------------------------------------------- the second factor

# Without this key nobody can keep a second factor: the server refuses an
# enrolment rather than writing a totp secret in clear. Mint one with
# `openssl rand -hex 32` and keep it beside the database password, because a
# lost key costs every enrolled account a re-enrolment.
FERRISTRACE_SECRETS__AT_REST_KEY=ad048a495f95f12b90a59e17b24d01c24d1389d4c217310511b928743f4aef87

# ----------------------------------------------------------- the mail relay

# Without one, nobody can ask for a reset link on the sign-in screen; hand
# one over with `ferristrace reset-password` instead.
#FERRISTRACE_MAIL__RELAY=mail.example.com
#FERRISTRACE_MAIL__USERNAME=postmaster
#FERRISTRACE_MAIL__PASSWORD=
#FERRISTRACE_MAIL__FROM=Ferristrace <no-reply@example.com>
#FERRISTRACE_MAIL__BASE_URL=https://ferristrace.example.com

# ----------------------------------------------------------- object store

# Without a bucket, an account is shown under its initials and the upload
# control on the profile screen answers that no object store is configured.
# Cloudflare R2 is what this was built against; the protocol is S3, so an S3
# bucket or a MinIO answer it too. R2 has one region and calls it "auto",
# which is what the server assumes when the line below is left out.
#FERRISTRACE_OBJECTS__ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#FERRISTRACE_OBJECTS__BUCKET=ferristrace-avatars
#FERRISTRACE_OBJECTS__ACCESS_KEY_ID=
#FERRISTRACE_OBJECTS__SECRET_ACCESS_KEY=
#FERRISTRACE_OBJECTS__REGION=auto
