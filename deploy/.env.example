# Copy to .env beside this file. Every line here is commented out, so a copy
# changes nothing: the stack comes up on a clean machine with no preparation.
#
# The file does two jobs. The names without a FERRISTRACE_ prefix are read by
# the compose file itself, to fill in a password or a port. The ones with it
# are handed to the server, which reads any FERRISTRACE_<BLOCK>__<FIELD> as
# the field of a block in ferristrace.toml.

# ---------------------------------------------------------------- the stack

# The three stores default to `ferristrace`, which is fine for a laptop and
# nothing else. Change both before this faces anything real — and before
# widening POSTGRES_BIND, which is what would put that database on a network.
#POSTGRES_PASSWORD=
#CLICKHOUSE_PASSWORD=
#POSTGRES_BIND=127.0.0.1
#POSTGRES_PORT=5432

#OTLP_GRPC_PORT=4317
#OTLP_HTTP_PORT=4318
#RETENTION_DAYS=30
#RUST_LOG=info

# false because this compose file serves plain HTTP. Put the server behind
# TLS and set it to true, or session cookies travel in the clear.
#COOKIE_SECURE=false

# A published image to run instead of building from this checkout.
#FERRISTRACE_IMAGE=ghcr.io/ferristrace/ferristrace:1.2.3

# ------------------------------------------------------------- FerrisKey

# The stack brings up FerrisKey itself and provisions its realm, its
# confidential client and the redirect uri on first start, so the four
# FERRISTRACE_OIDC__* settings below are written for you, into a file
# `server` reads after this one — nothing to copy here for the bundled
# FerrisKey to work. Its own database password defaults to `ferriskey`,
# which is fine for a laptop; change it before this faces anything real,
# same as the three stores above.
#FERRISKEY_DB_PASSWORD=

# Read once, before FerrisKey's own database holds anything, to create its
# first admin account — the one `ferriskey-init` signs in as to provision
# the realm. Without them FerrisKey falls back to admin/admin. Changing
# them afterwards changes nothing until that database is dropped.
#FERRISKEY_ADMIN_USERNAME=admin
#FERRISKEY_ADMIN_PASSWORD=admin
#FERRISKEY_ADMIN_EMAIL=admin@ferristrace.local

# FerrisKey's api and its console are bound to the loopback, like postgres
# above, because that admin password is the only door into the realm this
# stack trusts. Change FERRISKEY_ADMIN_PASSWORD before widening either.
#FERRISKEY_API_BIND=127.0.0.1
#FERRISKEY_WEBAPP_BIND=127.0.0.1

# ------------------------------------------------- signing in with an idp

# Already set for the bundled FerrisKey, by ferriskey-init, in a file read
# after this one. Set these four yourself only to point at a FerrisKey (or
# any OIDC provider) running somewhere else instead, in which case they win
# over what ferriskey-init wrote.
#FERRISTRACE_OIDC__ISSUER=https://id.example.com
#FERRISTRACE_OIDC__CLIENT_ID=ferristrace
#FERRISTRACE_OIDC__CLIENT_SECRET=
#FERRISTRACE_OIDC__REDIRECT_URI=https://ferristrace.example.com/auth/oidc/callback

# ------------------------------------------------------- sealed secrets

# Without this key nobody can keep a webhook channel secret: the server
# refuses to create the channel rather than write the secret in clear. Mint
# one with `openssl rand -hex 32` and keep it beside the database password,
# because a lost key leaves every webhook secret unreadable.
#FERRISTRACE_SECRETS__AT_REST_KEY=

# ----------------------------------------------------------- the mail relay

# Without one, no alert, page or status page update is mailed.
#FERRISTRACE_MAIL__RELAY=mail.example.com
#FERRISTRACE_MAIL__USERNAME=postmaster
#FERRISTRACE_MAIL__PASSWORD=
#FERRISTRACE_MAIL__FROM=Ferristrace <no-reply@example.com>
#FERRISTRACE_MAIL__BASE_URL=https://ferristrace.example.com
#FERRISTRACE_ALERTS__BASE_URL=https://ferristrace.example.com
#FERRISTRACE_ALERTS__ALLOW_PRIVATE_WEBHOOKS=false

# ----------------------------------------------------------- object store

# Without a bucket, an account is shown under its initials and the upload
# control on the profile screen answers that no object store is configured.
# Cloudflare R2 is what this was built against; the protocol is S3, so an S3
# bucket or a MinIO answer it too. R2 has one region and calls it "auto",
# which is what the server assumes when the line below is left out.
#FERRISTRACE_OBJECTS__ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#FERRISTRACE_OBJECTS__BUCKET=ferristrace-avatars
#FERRISTRACE_OBJECTS__ACCESS_KEY_ID=
#FERRISTRACE_OBJECTS__SECRET_ACCESS_KEY=
#FERRISTRACE_OBJECTS__REGION=auto
